{
  "name": "fulltext-bookmark",
  "private": true,
  "version": "2.0.0",
  "displayName": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "author": "RauX",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "browsers": "Chrome >= 127"
  },
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "npm run build && plasmo package",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "benchmark": "tsx scripts/benchmark.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "benchmark:chrome": "node scripts/browser-benchmark.mjs",
    "format:check": "prettier --check src tests scripts",
    "postbuild": "node scripts/license-notices.mjs"
  },
  "manifest": {
    "minimum_chrome_version": "127",
    "default_locale": "en",
    "permissions": [
      "storage",
      "tabs",
      "bookmarks",
      "alarms",
      "webNavigation",
      "unlimitedStorage",
      "sidePanel"
    ],
    "optional_permissions": [
      "history"
    ],
    "host_permissions": [
      "http://*/*",
      "https://*/*"
    ],
    "omnibox": {
      "keyword": "kw"
    },
    "commands": {
      "open-search": {
        "description": "__MSG_openSearchCommand__"
      }
    },
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
    }
  },
  "dependencies": {
    "dexie": "4.4.7",
    "opencc-js": "1.4.2",
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stemmer": "2.0.1",
    "stopword": "3.1.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/stopword": "2.0.3",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.7",
    "plasmo": "0.90.5",
    "prettier": "3.9.10",
    "svgo": "4.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "fflate": "0.8.3",
    "msgpackr": "2.1.4",
    "sharp": "0.35.5",
    "content-security-policy-parser": "0.6.0",
    "svelte": "5.57.3",
    "vue": "3.5.45",
    "@vue/server-renderer": "3.5.45",
    "tsup": "9.0.0",
    "esbuild": "$esbuild",
    "htmlnano": "3.6.1",
    "browserslist": "4.29.5"
  }
}
